<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="車載行程與電費自動計算"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- 每度電價格輸入 -->
    <EditText
        android:id="@+id/etElectricityPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="請輸入每度電價格 (例如: 1.5)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"/>

    <!-- 距離與電量輸入 (若需手動微調) -->
    <EditText
        android:id="@+id/etDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="行駛里數 (km)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etEnergy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="消耗電量 (kWh)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="20dp"/>

    <!-- 計算按鈕 -->
    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="立即計算費用"
        android:layout_marginBottom="24dp"/>

    <!-- 結果顯示區 -->
    <TextView
        android:id="@+id/tvTotalCost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="總充電費：$0.00"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCostPerKm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="每公里電費：$0.00"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvAvgConsumption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        text="平均能耗：0.0 kWh/km"
        android:textSize="16sp"/>

</LinearLayout>
